# ─────────────────────────────────────────────────────────────────────────────
# HIAOS — Humanitarian Intelligence & Accountability OS
# Environment Configuration Template v2.0
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in ALL required values before running in production
#   3. NEVER commit the .env file to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production | staging

# ── Database (REQUIRED for production) ───────────────────────────────────────
# Development: SQLite (default, do NOT use in production)
DATABASE_URL=sqlite:///./humanitarian.db
# Production example:
# DATABASE_URL=postgresql+psycopg://hiaos:STRONG_PASSWORD@localhost:5432/hiaos_production

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Security (REQUIRED — change ALL of these) ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-256-BIT-RANDOM-KEY

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SIGNING_SECRET=CHANGE-THIS-IN-PRODUCTION

# Token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── PII Encryption (RECOMMENDED for production) ───────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to disable PII encryption (not recommended for production)
PII_ENCRYPTION_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REPORTS=30/minute
RATE_LIMIT_AI=20/minute

# ── AI / OpenAI (REQUIRED for AI features) ───────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048

# ── Redis (REQUIRED for Celery, Rate Limiting, Caching) ──────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── File Storage — MinIO / S3 ─────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=humanitarian-system
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1

# ── Keycloak SSO (optional) ───────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=humanitarian
KEYCLOAK_CLIENT_ID=humanitarian-web
SSO_ENABLED=false

# ── Feature Flags ─────────────────────────────────────────────────────────────
AUTO_CREATE_TABLES=true          # Set to false in production — use Alembic
ENABLE_WEBSOCKETS=true
ENABLE_CELERY=false              # Set to true when Redis is running
ENABLE_METRICS=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | text
